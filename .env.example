# Copy to .env locally. Never commit real values.
ATLAS_TRADING_MODE=paper
ATLAS_STARTING_CASH=10000
ATLAS_ALLOW_NETWORK=0
ATLAS_ALLOW_LLM_NETWORK=0
ATLAS_OPENAI_MODEL=
OPENAI_API_KEY=
ATLAS_OPENAI_TIMEOUT=30
ATLAS_OPENAI_MAX_REQUESTS=1
ATLAS_OPENAI_MAX_INPUT_TOKENS=20000
ATLAS_OPENAI_MAX_OUTPUT_TOKENS=4000
# Optional. Estimated cost is recorded only when both prices are set (USD per 1M tokens).
# ATLAS_OPENAI_PRICE_INPUT_PER_MILLION=
# ATLAS_OPENAI_PRICE_OUTPUT_PER_MILLION=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Operator identity for SEC fair-access. Set locally; never commit a personal address.
ATLAS_EDGAR_USER_AGENT=
